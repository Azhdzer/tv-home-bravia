<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки лаунчера. После правки запустите launcher\build-and-install.ps1.
  Имена пакетов установленных приложений: tools\venv\Scripts\python.exe -I tools\tv.py "pm list packages -3"
-->
<resources>
    <!-- Приложения в доке, слева направо. Те, что не установлены, просто пропускаются. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>org.videolan.vlc</item>
    </string-array>

    <!-- Никогда не показывать плитками: приложение ТВ и его телегид (ТВ есть в меню «Входы»). -->
    <string-array name="hidden_apps">
        <item>com.sony.dtv.tvx</item>
        <item>com.sony.dtv.tvxlauncher.programguide</item>
    </string-array>

    <!-- Приложение ТВ у Sony: оно же показывает все входы HDMI. Стоит последним в меню «Входы». -->
    <string name="live_tv_package" translatable="false">com.sony.dtv.tvx</string>

    <!-- Запасной способ, если напрямую переключиться на вход не удалось. -->
    <string name="input_picker_package" translatable="false">com.sony.dtv.tvx</string>

    <!-- Плиток в ряду в сетке «Все приложения». -->
    <integer name="columns">5</integer>
</resources>
